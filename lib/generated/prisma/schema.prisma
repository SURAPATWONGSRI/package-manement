generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SymbolType {
  EURUSD
  USDJPY
  GOLD
  BTCUSD
}

enum Timeframe {
  M15
  M30
  H1
  D1
}

model PackageSelection {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String // เก็บชื่อผู้ใช้ ณ เวลาที่เลือกแพ็กเกจ (อาจต่างจากชื่อปัจจุบันในตาราง User)
  email  String // เก็บอีเมลผู้ใช้ ณ เวลาที่เลือกแพ็กเกจ (อาจต่างจากอีเมลปัจจุบันในตาราง User)

  symbol    String
  timeframe String
  startDate DateTime
  endDate   DateTime
  payPrice  Float
  paid      Boolean  @default(false)

  @@map("package_selections")
}

model Post {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title   String
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("posts")
}

model User {
  id            String   @id @default(uuid())
  createdAt     DateTime
  updatedAt     DateTime
  name          String
  email         String
  lineId        String?  @unique
  emailVerified Boolean
  image         String?
  role          UserRole @default(USER)

  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]
  posts    Post[]
  packages PackageSelection[]

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@unique([email])
  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  createdAt      DateTime
  updatedAt      DateTime
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  createdAt             DateTime
  updatedAt             DateTime
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  createdAt  DateTime?
  updatedAt  DateTime?
  identifier String
  value      String
  expiresAt  DateTime

  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("verifications")
}
